      "name_en": "Data flowchart",
      "name_vi": "Lưu đồ luồng dữ liệu",
      "summary": "Biểu diễn đường đi của dữ liệu và phương tiện dữ liệu qua các bước xử lý; bắt đầu và kết thúc bằng ký hiệu dữ liệu (hoặc ký hiệu đặc biệt §9.4)."
    },
    "program-flowchart": {
      "iso_section": "ISO 5807:1985 §5",
      "name_en": "Program flowchart",
      "name_vi": "Lưu đồ chương trình / thuật toán",
