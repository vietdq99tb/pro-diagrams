    },
    "system-flowchart": {
      "iso_section": "ISO 5807:1985 §6",
      "name_en": "System flowchart",
      "name_vi": "Lưu đồ hệ thống",
      "summary": "Kết hợp luồng điều khiển vận hành với luồng dữ liệu (nhập liệu thủ công, tệp đĩa, màn hình hiển thị, chứng từ đầu ra)."
    },
    "program-network": {
      "iso_section": "ISO 5807:1985 §7",
      "name_en": "Program network chart",
      "name_vi": "Sơ đồ mạng chương trình",
      "summary": "Biểu diễn kích hoạt giữa các chương trình (Control transfer §9.3.2.1 với mã P, T, I) và tương tác dữ liệu; mỗi chương trình xuất hiện một lần."
    },
    "system-resources": {
      "iso_section": "ISO 5807:1985 §8",
      "name_en": "System resources chart",
      "name_vi": "Sơ đồ tài nguyên hệ thống",
