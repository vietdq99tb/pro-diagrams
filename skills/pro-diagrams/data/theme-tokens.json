{
  "system_name": "Atelier Technical Warm",
  "version": "1.0.0",
  "philosophy": {
    "core_triad": "Kim tạo cấu trúc · Hỏa tạo dấu ấn · Thổ tạo độ ấm",
    "rules": [
      "Mộc đã vượng (49.1%): Không dùng xanh lá làm màu nhận diện chính hay tô nút Start/Process mặc định; chỉ cho phép sắc Ngọc khoáng trầm (#2D6A5B) ở chuỗi dữ liệu thứ cấp hoặc chỉ báo +Delta khi thật sự cần.",
      "Kim ưu tiên số 1 (0% -> khung kỷ luật): Trắng tinh khiết (#FFFFFF), Xám titan (#4A5860/#526068) và Đá phiến Kim-Thủy (#2B373E) kiến tạo khung chuẩn mực ISO 5807, đường luồng và trục tọa độ.",
      "Hỏa điểm nhớ (~10%): Gốm nung Terracotta trầm (#AD4333 / nền #FDF1EE) chỉ tập trung vào nút Quyết định (Decision), Đường găng (Critical Path), Cảnh báo ngoại lệ và Chuỗi KPI tiêu điểm.",
      "Thổ nền ấm (48% sáng + 6% điểm ấm): Nền giấy sứ ấm (#F8F6F2) và Cát hổ phách dịu (#8C5D2B / nền #FAF4EA) khử cảm giác lạnh công nghiệp của xám Kim mà không sa vào nâu đất nặng.",
      "Thủy lưu thông: Xanh khoáng Kim-Thủy (#395E73 / nền #EDF3F6) đại diện cho luồng dữ liệu vào/ra (Data I/O), Cơ sở dữ liệu (Database) và Hiển thị."
    ],
    "visual_ratio_budget": {
      "warm_light_canvas_and_white": 0.48,
      "dark_structural_slate_and_ink": 0.24,
      "technical_metal_neutrals": 0.12,
      "focal_kiln_terracotta": 0.10,
      "warm_sand_and_mineral_flow": 0.06
    }
  },
  "typography": {
    "font_family_primary": "Open Sans",
    "font_stack_css": "'Open Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "font_stack_mono": "'JetBrains Mono', 'IBM Plex Mono', Consolas, monospace",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;600&display=swap",
    "vietnamese_rules": {
      "min_node_height_px": 60,
      "three_line_node_height_px": 76,
      "line_height_html": 1.42,
      "char_width_em_sans": 0.617,
      "char_width_em_mono": 0.62,
      "max_edge_label_chars_vi": 18,
      "spacing_top_bottom_px": 6,
      "spacing_left_right_px": 8
    }
  },
  "themes": {
